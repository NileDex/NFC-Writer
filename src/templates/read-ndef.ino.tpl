/*
 * {{TITLE}}
 *
 * Generated by NFC Reader (NFC Writer tool) - prints the tag UID, tag type
 * and any NDEF content to the Serial Monitor.
 *
 * Board:     ESP32 Dev Module (ESP32 / ESP32-S3 - adjust SPI pins if needed)
 * Library:   "MFRC522" by Miguel Balboa (Arduino Library Manager)
 * Serial:    {{BAUD}} baud  (open the Serial Monitor at this speed)
 *
 * Wiring (RC522 -> ESP32):
 *   3.3V -> 3.3V   GND -> GND   RST -> GPIO 22   SDA -> GPIO 5
 *   MISO -> GPIO 19  MOSI -> GPIO 23  SCK -> GPIO 18   IRQ -> not connected
 *
 * IMPORTANT: power the RC522 from 3.3V only. Never 5V.
 */

#include <SPI.h>
#include <MFRC522.h>
#include <string.h>

#define RST_PIN 22
#define SS_PIN 5
#define BAUD {{BAUD}}

MFRC522 mfrc522(SS_PIN, RST_PIN);

// Reads up to NTAG216-sized tags (888 bytes user memory = 222 pages).
#define MAX_MEMORY 892
static uint8_t memory[MAX_MEMORY];

static const char *URI_PREFIXES[] = {
    "",                    // 0x00 no prefix
    "http://www.",         // 0x01
    "http://",             // 0x02
    "https://www.",        // 0x03
    "https://",            // 0x04
    "tel:",                // 0x05
    "mailto:",             // 0x06
    "ftp://anonymous:anonymous@", // 0x07
    "ftp://ftp.",          // 0x08
    "ftps://",             // 0x09
    "sftp://",             // 0x0A
    "smb://",              // 0x0B
    "nfs://",              // 0x0C
    "ftp://",              // 0x0D
    "dav://",              // 0x0E
    "news:",               // 0x0F
    "telnet://",           // 0x10
    "imap:",               // 0x11
    "rtsp://",             // 0x12
    "urn:",                // 0x13
    "pop:",                // 0x14
    "sip:",                // 0x15
    "sips://",             // 0x16
    "tftp:",               // 0x17
    "btspp:",              // 0x18
    "btl2cap:",            // 0x19
    "btgoep:",             // 0x1A
    "tcpobex:",            // 0x1B
    "irdaobex:",           // 0x1C
    "file:",               // 0x1D
    "urn:epc:id:",         // 0x1E
    "urn:epc:tag:",        // 0x1F
    "urn:epc:pat:",        // 0x20
    "urn:epc:raw:",        // 0x21
    "urn:epc:",            // 0x22
    "urn:nfc:",            // 0x23
};

static const uint8_t URI_PREFIX_COUNT = sizeof(URI_PREFIXES) / sizeof(URI_PREFIXES[0]);

static void printUid() {
  for (uint8_t i = 0; i < mfrc522.uid.size; i++) {
    if (mfrc522.uid.uidByte[i] < 0x10) Serial.print('0');
    Serial.print(mfrc522.uid.uidByte[i], HEX);
  }
}

static void printHex(const uint8_t *data, uint16_t length) {
  for (uint16_t i = 0; i < length; i++) {
    if (data[i] < 0x10) Serial.print('0');
    Serial.print(data[i], HEX);
  }
}

static bool readPage(uint8_t page, uint8_t out[4]) {
  uint8_t buffer[18];
  uint8_t size = sizeof(buffer);
  if (!mfrc522.MIFARE_Read(page, buffer, &size)) return false;
  memcpy(out, buffer, 4);
  return true;
}

static void waitForRemoval() {
  while (true) {
    delay(60);
    if (!mfrc522.PICC_IsNewCardPresent()) break;
    if (mfrc522.PICC_ReadCardSerial()) mfrc522.PICC_HaltA();
  }
}

// Extract one WSC attribute (16-bit id, 16-bit length, value).
static bool findWifiAttribute(const uint8_t *data, uint16_t length, uint16_t wanted,
                              const uint8_t **value, uint16_t *valueLength) {
  uint16_t pos = 0;
  while (pos + 4 <= length) {
    uint16_t id = ((uint16_t)data[pos] << 8) | data[pos + 1];
    uint16_t len = ((uint16_t)data[pos + 2] << 8) | data[pos + 3];
    pos += 4;
    if (pos + len > length) return false;
    if (id == wanted) {
      *value = data + pos;
      *valueLength = len;
      return true;
    }
    pos += len;
  }
  return false;
}

// Print the Wi-Fi credential out of an application/vnd.wfa.wsc payload.
static void printWifiAttributes(const uint8_t *payload, uint16_t length) {
  const uint8_t *credential = payload;
  uint16_t credentialLength = length;
  const uint8_t *value;
  uint16_t valueLength;

  // Prefer the Credential compound attribute (0x100E) when present.
  if (findWifiAttribute(payload, length, 0x100E, &value, &valueLength)) {
    credential = value;
    credentialLength = valueLength;
  }

  if (findWifiAttribute(credential, credentialLength, 0x1045, &value, &valueLength)) {
    Serial.print(F("  SSID:     "));
    Serial.write(value, valueLength);
    Serial.println(F(""));
  }
  if (findWifiAttribute(credential, credentialLength, 0x1003, &value, &valueLength) &&
      valueLength == 2) {
    uint16_t auth = ((uint16_t)value[0] << 8) | value[1];
    Serial.print(F("  Auth:     0x"));
    if (auth < 0x1000) Serial.print('0');
    Serial.println(auth, HEX);
  }
  if (findWifiAttribute(credential, credentialLength, 0x100F, &value, &valueLength) &&
      valueLength == 2) {
    uint16_t enc = ((uint16_t)value[0] << 8) | value[1];
    Serial.print(F("  Encrypt:  0x"));
    if (enc < 0x1000) Serial.print('0');
    Serial.println(enc, HEX);
  }
  if (findWifiAttribute(credential, credentialLength, 0x1027, &value, &valueLength)) {
    Serial.print(F("  Key:      "));
    Serial.write(value, valueLength);
    Serial.println(F(""));
  }
}

// Decode an NDEF message and print each record in a readable form.
static void printNdef(const uint8_t *message, uint16_t messageLength) {
  uint16_t pos = 0;
  uint16_t recordNumber = 0;

  while (pos < messageLength) {
    uint8_t header = message[pos++];
    bool me = (header & 0x40) != 0;
    bool shortRecord = (header & 0x10) != 0;
    bool hasId = (header & 0x08) != 0;
    uint8_t tnf = header & 0x07;

    if (pos >= messageLength) break;
    uint8_t typeLength = message[pos++];
    uint32_t payloadLength;
    if (shortRecord) {
      payloadLength = message[pos++];
    } else {
      if (pos + 3 >= messageLength) break;
      payloadLength = ((uint32_t)message[pos] << 24) | ((uint32_t)message[pos + 1] << 16) |
                      ((uint32_t)message[pos + 2] << 8) | message[pos + 3];
      pos += 4;
    }
    uint8_t idLength = 0;
    if (hasId) {
      if (pos >= messageLength) break;
      idLength = message[pos++];
    }
    if ((uint32_t)pos + typeLength + idLength + payloadLength > messageLength) {
      Serial.println(F("  (truncated record)"));
      return;
    }
    const uint8_t *type = message + pos;
    pos += typeLength + idLength;
    const uint8_t *payload = message + pos;
    pos += (uint16_t)payloadLength;

    recordNumber++;
    Serial.print(F("Record "));
    Serial.print(recordNumber);
    Serial.print(F(": "));

    if (tnf == 0x01 && typeLength == 1 && type[0] == 'U' && payloadLength >= 1) {
      uint8_t code = payload[0];
      const char *prefix = (code < URI_PREFIX_COUNT) ? URI_PREFIXES[code] : "";
      Serial.print(F("URI "));
      Serial.print(prefix);
      Serial.write(payload + 1, payloadLength - 1);
      Serial.println(F(""));
    } else if (tnf == 0x01 && typeLength == 1 && type[0] == 'T' && payloadLength >= 1) {
      uint8_t status = payload[0];
      uint8_t langLength = status & 0x3F;
      if (1u + langLength <= payloadLength) {
        Serial.print(F("TEXT ("));
        Serial.write(payload + 1, langLength);
        Serial.print(F(") "));
        Serial.write(payload + 1 + langLength, payloadLength - 1 - langLength);
        Serial.println(F(""));
      } else {
        Serial.println(F("TEXT (malformed)"));
      }
    } else if (tnf == 0x02) {
      Serial.print(F("MIME "));
      Serial.write(type, typeLength);
      Serial.println(F(""));
      if (typeLength == 23 && memcmp(type, "application/vnd.wfa.wsc", 23) == 0) {
        printWifiAttributes(payload, (uint16_t)payloadLength);
      }
    } else {
      Serial.print(F("tnf="));
      Serial.print(tnf);
      Serial.print(F(" type="));
      Serial.write(type, typeLength);
      Serial.print(F(" payload="));
      Serial.print((uint32_t)payloadLength);
      Serial.println(F(" bytes"));
    }

    if (me) break;
  }

  if (recordNumber == 0) Serial.println(F("(no NDEF records)"));
}

void setup() {
  Serial.begin(BAUD);
  delay(250);
  SPI.begin(18, 19, 23, 5); // SCK, MISO, MOSI, SS - matches the wiring table
  mfrc522.PCD_Init();
  Serial.println(F(""));
  Serial.println(F("NFC Reader - reading mode"));
  Serial.println(F("Waiting for a tag..."));
}

void loop() {
  if (!mfrc522.PICC_IsNewCardPresent()) return;
  if (!mfrc522.PICC_ReadCardSerial()) return;

  Serial.println(F("---- tag detected ----"));
  Serial.print(F("UID:    "));
  printUid();
  Serial.println(F(""));
  Serial.print(F("SAK:    0x"));
  Serial.println(mfrc522.uid.sak, HEX);

  if (mfrc522.uid.sak != 0x00) {
    Serial.println(F("Type:   not a Type 2 tag (NTAG/Ultralight) - skipping NDEF read"));
    mfrc522.PICC_HaltA();
    waitForRemoval();
    Serial.println(F("Waiting for a tag..."));
    return;
  }

  uint8_t cc[4];
  if (!readPage(3, cc) || cc[0] != 0xE1) {
    Serial.println(F("No capability container - tag is not a formatted Type 2 tag."));
    mfrc522.PICC_HaltA();
    waitForRemoval();
    Serial.println(F("Waiting for a tag..."));
    return;
  }

  uint16_t capacity = (uint16_t)cc[2] * 8u;
  Serial.print(F("Type:   NTAG-style Type 2, NDEF capacity "));
  Serial.print(capacity);
  Serial.println(F(" bytes"));

  uint16_t readable = (capacity <= MAX_MEMORY) ? capacity : (MAX_MEMORY & (uint16_t)~3);
  uint16_t stored = 0;
  for (uint16_t page = 4; stored < readable; page++) {
    uint8_t buf[4];
    if (!readPage((uint8_t)page, buf)) break;
    memcpy(memory + stored, buf, 4);
    stored += 4;
  }

  // Walk the Type 2 TLVs to find the NDEF message.
  const uint8_t *ndefStart = NULL;
  uint16_t ndefLength = 0;
  uint16_t pos = 0;
  bool sawTerminator = false;
  while (pos < stored) {
    uint8_t tag = memory[pos];
    if (tag == 0x00) {
      pos += 1;
      continue;
    }
    if (tag == 0xFE) {
      sawTerminator = true;
      break;
    }
    if (pos + 1 >= stored) break;
    uint16_t length = memory[pos + 1];
    uint16_t headerSize = 2;
    if (length == 0xFF) {
      if (pos + 3 >= stored) break;
      length = ((uint16_t)memory[pos + 2] << 8) | memory[pos + 3];
      headerSize = 4;
    }
    if (tag == 0x03) {
      ndefStart = memory + pos + headerSize;
      ndefLength = length;
      break;
    }
    pos += headerSize + length;
  }

  if (ndefStart == NULL) {
    Serial.print(sawTerminator ? F("No NDEF message stored") : F("Could not parse the TLV area"));
    Serial.println(F(""));
  } else {
    Serial.print(F("NDEF:   "));
    Serial.print(ndefLength);
    Serial.println(F(" bytes"));
    Serial.print(F("Raw:    "));
    printHex(ndefStart, ndefLength);
    Serial.println(F(""));
    printNdef(ndefStart, ndefLength);
  }

  mfrc522.PICC_HaltA();
  waitForRemoval();
  Serial.println(F("Waiting for a tag..."));
}
