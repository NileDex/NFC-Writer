/*
 * {{TITLE}}
 *
 * Generated by NFC Writer (client-side tool) - payload is baked in, so this
 * sketch writes the same NDEF message every time a tag is presented.
 *
 * Board:     ESP32 Dev Module (ESP32 / ESP32-S3 - adjust SPI pins if needed)
 * Library:   "MFRC522" by Miguel Balboa (Arduino Library Manager)
 * Serial:    {{BAUD}} baud
 *
 * Wiring (RC522 -> ESP32):
 *   3.3V -> 3.3V   GND -> GND   RST -> GPIO 22   SDA -> GPIO 5
 *   MISO -> GPIO 19  MOSI -> GPIO 23  SCK -> GPIO 18   IRQ -> not connected
 *
 * IMPORTANT: power the RC522 from 3.3V only. Never 5V.
 *
 * Payload:  {{PAYLOAD_TEXT_CPP}}
 * NDEF:     {{NDEF_LENGTH}} bytes - uses {{BYTES_USED}} of the
 *           {{CAPACITY}} bytes of NTAG213 user memory.
 */

#include <SPI.h>
#include <MFRC522.h>
#include <string.h>

#define RST_PIN 22
#define SS_PIN 5
#define BAUD {{BAUD}}

MFRC522 mfrc522(SS_PIN, RST_PIN);

// NDEF message (NFC Forum binary format), built by NFC Writer.
static const uint8_t NDEF_MSG[] = {{NDEF_BYTES}};
static const uint16_t NDEF_LEN = {{NDEF_LENGTH}};
static const uint16_t TLV_LEN = NDEF_LEN + 3u; // 0x03, length, 0xFE
static_assert(NDEF_LEN <= 254, "Payload exceeds the short TLV form");

// Capability Container defaults (NXP NTAG datasheet, byte 2 = NDEF size / 8)
static const uint8_t CC_NTAG213[4] = {0xE1, 0x10, 0x12, 0x00};

static void printUid() {
  for (uint8_t i = 0; i < mfrc522.uid.size; i++) {
    if (mfrc522.uid.uidByte[i] < 0x10) Serial.print('0');
    Serial.print(mfrc522.uid.uidByte[i], HEX);
  }
}

static bool readPage(uint8_t page, uint8_t out[4]) {
  uint8_t buffer[18];
  uint8_t size = sizeof(buffer);
  if (!mfrc522.MIFARE_Read(page, buffer, &size)) return false;
  memcpy(out, buffer, 4);
  return true;
}

static bool writePage(uint8_t page, const uint8_t data[4]) {
  uint8_t buffer[4];
  memcpy(buffer, data, 4);
  return mfrc522.MIFARE_Ultralight_Write(page, buffer, 4);
}

// TLV layout: 0x03 | length | NDEF message | 0xFE (short form, <= 254 bytes)
static uint8_t tlvByte(uint16_t index) {
  if (index == 0) return 0x03;
  if (index == 1) return (uint8_t)NDEF_LEN;
  if (index < 2u + NDEF_LEN) return NDEF_MSG[index - 2u];
  return 0xFE;
}

// Keep the sketch from rewriting a tag that is still on the antenna.
static void waitForRemoval() {
  while (true) {
    delay(60);
    if (!mfrc522.PICC_IsNewCardPresent()) break;
    if (mfrc522.PICC_ReadCardSerial()) mfrc522.PICC_HaltA();
  }
}

static void finish(const __FlashStringHelper *status) {
  Serial.println(status);
  mfrc522.PICC_HaltA();
  waitForRemoval();
  Serial.println(F("Waiting for a tag..."));
}

void setup() {
  Serial.begin(BAUD);
  delay(250);
  SPI.begin(18, 19, 23, 5); // SCK, MISO, MOSI, SS - matches the wiring table
  mfrc522.PCD_Init();
  Serial.println(F(""));
  Serial.println(F("NFC Writer - custom write firmware"));
  Serial.print(F("Payload: "));
  Serial.println(F("{{PAYLOAD_TEXT_CPP}}"));
  Serial.print(F("NDEF bytes: "));
  Serial.println(NDEF_LEN);
  Serial.println(F("Waiting for a tag..."));
}

void loop() {
  if (!mfrc522.PICC_IsNewCardPresent()) return;
  if (!mfrc522.PICC_ReadCardSerial()) return;

  Serial.print(F("Tag uid="));
  printUid();
  Serial.print(F(" sak=0x"));
  Serial.print(mfrc522.uid.sak, HEX);
  Serial.println(F(""));

  // Type 2 tags (NTAG21x / MIFARE Ultralight) report SAK 0x00.
  if (mfrc522.uid.sak != 0x00) {
    Serial.println(F("ERROR unsupported_tag (this sketch writes Type 2 tags only)"));
    finish(F(""));
    return;
  }

  uint8_t cc[4];
  uint16_t capacity = {{CAPACITY}};
  if (!readPage(3, cc)) {
    Serial.println(F("ERROR read_failed (could not read the capability container)"));
    finish(F(""));
    return;
  }
  if (cc[0] == 0xE1 && cc[2] > 0) {
    capacity = (uint16_t)cc[2] * 8u;
  } else {
    // Blank/cheap tag: give it a proper Type 2 capability container.
    if (!writePage(3, CC_NTAG213)) {
      Serial.println(F("ERROR write_failed (could not set the capability container)"));
      finish(F(""));
      return;
    }
    capacity = {{CAPACITY}};
  }

  if (TLV_LEN > capacity) {
    Serial.print(F("ERROR payload_too_large bytes="));
    Serial.print(TLV_LEN);
    Serial.print(F(" capacity="));
    Serial.println(capacity);
    finish(F(""));
    return;
  }

  uint8_t page = 4;
  for (uint16_t offset = 0; offset < TLV_LEN; offset += 4) {
    uint8_t buf[4];
    for (uint8_t i = 0; i < 4; i++) {
      uint16_t index = offset + i;
      buf[i] = (index < TLV_LEN) ? tlvByte(index) : 0x00;
    }
    if (!writePage(page, buf)) {
      Serial.print(F("ERROR write_failed at page "));
      Serial.println(page);
      finish(F(""));
      return;
    }
    page++;
  }

  Serial.print(F("OK uid="));
  printUid();
  Serial.print(F(" bytes="));
  Serial.println(TLV_LEN);
  finish(F(""));
}
